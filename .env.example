# taimei-auth ローカル開発用 env テンプレート。
# `cp .env.example .env` してから docker compose up すること。
# .env に書いた値は docker-compose.yml の environment より弱い (compose が上書き) ため、
# compose で固定している DATABASE_URL / REDIS_URL / AUTH_SERVICE_URL 等は .env に書いても無効。
# .env はホスト側で `bun run dev` する時の参照元、または compose で参照されない optional な
# secret (AUTH_GITHUB_*, AUTH_RESEND_KEY 等) を入れる用途。

# === ホスト側で bun run dev する時用 (compose では上書きされる) ===
DATABASE_URL=postgres://postgres:password@localhost:5435/auth
REDIS_URL=redis://localhost:6380
APP_ENV=development
AUTH_SERVICE_URL=http://localhost:3100
AUTH_TRUSTED_ORIGINS=http://localhost:3100,http://localhost:3000,http://localhost:3001
AUTH_COOKIE_DOMAIN=localhost
APP_NAME=taimei

# === optional: 設定しなくても Magic Link console.log で動く ===
# GitHub OAuth: 両方揃っている時のみ有効化される (src/auth.ts の conditional)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Resend: 未設定なら src/auth.ts:71 の isLocalEnvironment() 分岐で console.log のみ
# AUTH_RESEND_KEY=
# AUTH_FROM_EMAIL_MAGIC_LINK=onboarding@resend.dev
# AUTH_FROM_EMAIL_WELCOME=onboarding@resend.dev

# サービス間 RPC 認証 key (consumer app から /rpc/* を呼ぶ時)
# AUTH_SERVICE_KEY=

# Vercel Blob (avatar upload)
# BLOB_READ_WRITE_TOKEN=

# Sentry
# SENTRY_DSN=
