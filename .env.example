# taimei-auth をローカルで開発するための env テンプレート。
# `cp .env.example .env` してから docker compose up する。
# .env に書いた値は docker-compose.yml の environment に上書きされるため、
# compose で固定している DATABASE_URL や AUTH_SERVICE_URL などは .env に書いても反映されない。
# .env は、compose を使わず host で起動する時 (README「ローカル起動」) の参照元として使うか、
# compose が参照しない任意の secret (AUTH_GITHUB_* や AUTH_RESEND_KEY など) を入れるために使う。

# === host で起動する時に使う値 (compose では上書きされる。値は docker-compose.yml の auth-service と同じ) ===
DATABASE_URL=postgres://postgres:password@localhost:5435/auth
APP_ENV=development
AUTH_SERVICE_URL=http://auth.taimei-code.localhost:3100
AUTH_TRUSTED_ORIGINS=http://app.taimei-code.localhost:3001,http://auth.taimei-code.localhost:3100
AUTH_COOKIE_DOMAIN=taimei-code.localhost
APP_NAME=taimei
AUTH_SECRET=dev-secret-for-local-development-32chars
# サービス間 RPC の認証 key。consumer app が /rpc/* に送る key と同じ値にする。未設定だと RPC は 503 になる
AUTH_SERVICE_KEY=local-dev-key

# === 任意の設定 ===
# GitHub OAuth は両方そろっている時だけ有効になる (src/auth.ts の条件分岐)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# 開発環境と e2e の server は、この key の有無にかかわらずメールを送らず、送る内容を記録して console.log に出す。
# key を使うのは management/* の script (MFA の無効化の通知メールなど) で、未設定だと送信の時に失敗する
# AUTH_RESEND_KEY=
# AUTH_FROM_EMAIL_MAGIC_LINK=onboarding@resend.dev
# AUTH_FROM_EMAIL_WELCOME=onboarding@resend.dev
# AUTH_FROM_EMAIL_INVITATION=onboarding@resend.dev

# ローテーション中だけ設定する。旧 key を一時的に併存させ、停止せずにローテーションする (docs/runbook/service-key-rotation.md)
# AUTH_SERVICE_KEY_PREVIOUS=

# 事業所メンバー招待の rate limit。事業所ごとの 1 時間あたりの招待上限で、未設定なら 50 件/時になる
# INVITATION_HOURLY_LIMIT_PER_COMPANY=50

# メールに載せるサポート窓口と abuse 情報のリンク。未設定なら下記の既定値が使われる
# AUTH_SUPPORT_EMAIL=support@taimei-code.com
# AUTH_ABUSE_INFO_URL=https://taimei-code.com/security

# Vercel Blob (avatar upload)
# BLOB_READ_WRITE_TOKEN=

# Sentry
# SENTRY_DSN=

# MFA の有効化・無効化などを知らせるセキュリティ通知メールの差出人 (未設定なら onboarding@resend.dev)
# AUTH_FROM_EMAIL_SECURITY=noreply@transactional.taimei-code.com

# client IP の導出方法 (audit ログの ip と、IP 単位の rate limit の key の出所になる)。
# 開発環境 (wrangler dev) と本番の Workers は cf-connecting-ip を使うため設定しなくてよい。
# 本番以外の Bun の server (testing/server.ts) では必須で、未設定または非負整数以外だと起動を拒否する。
# 値は、自前の proxy が X-Forwarded-For に追記する段数で、末尾から N 番目を client とみなす。
#   1 は proxy 1 段 (nginx や ALB など)、2 以上はその段数、0 は proxy 無しで直接公開する構成 (ヘッダを信用しない)
# 詳細は README「運用」の AUTH_TRUSTED_PROXY_HOPS
# AUTH_TRUSTED_PROXY_HOPS=1

# MFA の secret とリカバリーコードを暗号化する鍵の一覧。形式は v1:<base64 32byte>[,v2:...] で、version が最大のものが現行の鍵になる
# 生成は echo "v1:$(openssl rand -base64 32)" で行う。以下は開発用の固定ダミーで、production とは共有しない
MFA_TOTP_ENCRYPTION_KEYS=v1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=