# taimei-auth をローカルで開発するための env テンプレート。
# `cp .env.example .env` してから docker compose up する。
# .env に書いた値は docker-compose.yml の environment に上書きされるため、
# compose で固定している DATABASE_URL や AUTH_SERVICE_URL などは .env に書いても反映されない。
# .env は、ホスト側で `bun run dev` する時の参照元として使うか、compose が参照しない任意の
# secret (AUTH_GITHUB_* や AUTH_RESEND_KEY など) を入れるために使う。

# === ホスト側で bun run dev する時に使う値 (compose では上書きされる) ===
DATABASE_URL=postgres://postgres:password@localhost:5435/auth
APP_ENV=development
AUTH_SERVICE_URL=http://localhost:3100
AUTH_TRUSTED_ORIGINS=http://localhost:3100,http://localhost:3000,http://localhost:3001
AUTH_COOKIE_DOMAIN=localhost
APP_NAME=taimei

# === 任意の設定。設定しなくても Magic Link は console.log への出力で動く ===
# GitHub OAuth は両方そろっている時だけ有効になる (src/auth.ts の条件分岐)
# AUTH_GITHUB_ID=
# AUTH_GITHUB_SECRET=

# Resend が未設定なら、src/auth.ts:71 の isLocalEnvironment() の分岐で console.log に出力するだけになる
# AUTH_RESEND_KEY=
# AUTH_FROM_EMAIL_MAGIC_LINK=onboarding@resend.dev
# AUTH_FROM_EMAIL_WELCOME=onboarding@resend.dev
# AUTH_FROM_EMAIL_INVITATION=onboarding@resend.dev

# サービス間 RPC の認証 key (consumer app から /rpc/* を呼ぶ時に使う)
# AUTH_SERVICE_KEY=
# ローテーション中だけ設定する。旧 key を一時的に併存させ、停止せずにローテーションする (ADR-001 Phase 3 の dual-key)
# AUTH_SERVICE_KEY_PREVIOUS=

# 事業所メンバー招待 (ADR-009 Phase B) の rate limit。事業所ごとの 1 時間あたりの招待上限で、未設定なら 50 件/時になる
# INVITATION_HOURLY_LIMIT_PER_COMPANY=50

# Phishing 対策バナー (本番だけ表示) に表示するサポート窓口と abuse 情報のリンク。未設定なら下記の既定値が使われる
# AUTH_SUPPORT_EMAIL=support@taimei-code.com
# AUTH_ABUSE_INFO_URL=https://taimei-code.com/security

# Vercel Blob (avatar upload)
# BLOB_READ_WRITE_TOKEN=

# Sentry
# SENTRY_DSN=

# MFA の有効化・無効化などを知らせるセキュリティ通知メールの差出人 (未設定なら onboarding@resend.dev)
# AUTH_FROM_EMAIL_SECURITY=noreply@transactional.taimei-code.com

# client IP の導出方法 (audit ログの ip と、IP 単位の rate limit の key の出所になる)。
# Cloudflare Workers の本番は cf-connecting-ip を使うため設定しなくてよい。以下は Bun (compose、e2e、
# 自前運用) 向けの設定である。値は、自前の proxy が X-Forwarded-For に追記する段数で、末尾から N 番目を client とみなす。
#   1 は proxy 1 段 (nginx や ALB など)、2 以上はその段数、0 は proxy 無しで直接公開する構成 (ヘッダを信用しない)
# production 以外では、未設定なら 1 段相当で動く。APP_ENV=production の Bun は、未設定または非負整数以外だと
# 起動を拒否する (詳細は README「運用」の AUTH_TRUSTED_PROXY_HOPS)。
# AUTH_TRUSTED_PROXY_HOPS=1

# MFA の secret とリカバリーコードを暗号化する鍵の一覧。形式は v1:<base64 32byte>[,v2:...] で、version が最大のものが現行の鍵になる
# 生成は echo "v1:$(openssl rand -base64 32)" で行う。以下は開発用の固定ダミーで、production とは共有しない
MFA_TOTP_ENCRYPTION_KEYS=v1:MDEyMzQ1Njc4OWFiY2RlZjAxMjM0NTY3ODlhYmNkZWY=
