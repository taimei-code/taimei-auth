{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "testing/server.ts",
    "testing/worker.ts",
    "testing/staging-worker.ts",
    "testing/prepare-staging-database.ts",
    "testing/check-staging-database.ts",
    "testing/redirect-hosts.ts",
    "web/index.html",
    "web/non-production/main.ts",
    "db/migrate.ts",
    "db/migrate-manual.ts",
    "management/*.ts",
    "infra/*.ts",
    "e2e/*.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "web/vite.config.ts",
    "web/tailwind.config.ts"
  ],
  "ignorePatterns": ["repos/**"],
  "ignoreFindings": ["src/gen/**", "packages/auth-client/src/gen/**"],
  "ignoreDependencies": [
    "@bufbuild/protoc-gen-es",
    "@effect/tsgo",
    "@effect/platform-bun",
    "@effect/platform-node"
  ],
  "usedClassMembers": [
    {
      "extends": "DurableObject",
      "members": ["*"]
    }
  ],
  "rules": {
    "dev-dependencies-in-production": "off"
  },
  "ignoreExports": [
    {
      "file": "src/company/org-code.ts",
      "exports": ["OrgCode"]
    },
    {
      "file": "db/repositories/invitation.ts",
      "exports": ["Role"]
    },
    {
      "file": "src/membership/policy.ts",
      "exports": ["Role"]
    },
    {
      "file": "src/gen/auth/v1/auth_pb.ts",
      "exports": ["Session"]
    },
    {
      "file": "web/src/app/*/main.ts",
      "exports": ["Model", "Message", "init", "update", "view"]
    },
    {
      "file": "web/src/*/pages/*.ts",
      "exports": ["Model", "Message", "OutMessage", "init", "update", "view"]
    }
  ]
}
