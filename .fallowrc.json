{
  "$schema": "./node_modules/fallow/schema.json",
  "entry": [
    "testing/bun-dev.ts",
    "testing/server.ts",
    "testing/worker.ts",
    "web/index.html",
    "web/non-production/main.tsx",
    "db/migrate.ts",
    "db/migrate-manual.ts",
    "management/*.ts",
    "e2e/*.ts",
    "drizzle.config.ts",
    "playwright.config.ts",
    "web/vite.config.ts",
    "web/tailwind.config.ts"
  ],
  "ignoreFindings": ["src/gen/**", "packages/auth-client/src/gen/**"],
  "ignoreDependencies": ["@bufbuild/protoc-gen-es", "@effect/tsgo"],
  "usedClassMembers": [
    {
      "extends": "DurableObject",
      "members": ["*"]
    }
  ],
  "rules": {
    "dev-dependencies-in-production": "off"
  },
  "ignoreExports": [
    {
      "file": "src/company/org-code.ts",
      "exports": ["OrgCode"]
    },
    {
      "file": "db/repositories/invitation.ts",
      "exports": ["Role"]
    },
    {
      "file": "src/membership/policy.ts",
      "exports": ["Role"]
    },
    {
      "file": "src/gen/auth/v1/auth_pb.ts",
      "exports": ["Session"]
    }
  ]
}
