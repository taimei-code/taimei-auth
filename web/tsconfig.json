{
  "extends": "../tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "jsx": null,
    "moduleResolution": "bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "paths": {
      "@core/*": ["./src/*", "../src/*"]
    }
  },
  "include": [
    "src/**/*.ts",
    "src/**/*.tsx",
    "non-production/**/*.ts",
    "non-production/**/*.tsx",
    "vite.config.ts"
  ]
}
