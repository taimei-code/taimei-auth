{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": [
    {
      "name": "taimei",
      "specifier": "./lint/oxlint-plugin.mts"
    },
    {
      "name": "foldkit",
      "specifier": "@foldkit/oxlint-plugin"
    }
  ],
  "categories": {
    "correctness": "error"
  },
  "ignorePatterns": [
    "repos/**",
    "src/gen/**",
    "packages/auth-client/src/gen/**",
    "packages/auth-client/dist/**",
    "web/dist/**",
    "drizzle/**",
    "worker-configuration.d.ts"
  ],
  "rules": {
    "no-unused-vars": [
      "error",
      {
        "argsIgnorePattern": "^_",
        "varsIgnorePattern": "^_",
        "caughtErrorsIgnorePattern": "^_"
      }
    ],
    "no-template-curly-in-string": "error",
    "unicorn/no-useless-spread": "off",
    "eqeqeq": "error",
    "no-fallthrough": "error",
    "radix": "error",
    "import/no-commonjs": "error",
    "typescript/no-misused-promises": "error",
    "typescript/return-await": "error",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-mixed-enums": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/unbound-method": "off",
    "typescript/no-useless-default-assignment": "off",
    "taimei/no-fetch-in-web": "error",
    "taimei/spa-http-client-only-in-foldkit-files": "error",
    "taimei/no-effect-http-value-import-in-web": "error",
    "taimei/auth-client-list-only-in-auth-client-read": "error",
    "taimei/leave-spa-only-in-leave-spa": "error",
    "taimei/no-ignored-cause-in-web": "error",
    "taimei/no-or-else-succeed": "error",
    "taimei/sign-out-only-in-sign-out": "error",
    "taimei/cause-lookup-only-in-failure-message": "error",
    "taimei/no-tag-comparison-in-web": "error",
    "taimei/client-navigation-uses-own-routes": "error",
    "taimei/no-inner-html-in-web": "error",
    "taimei/app-env-only-in-sentry-options": "error",
    "taimei/no-build-mode-in-web": "error",
    "taimei/run-in-transaction-only-in-transaction": "error",
    "taimei/spa-api-path-only-in-contract": "error",
    "taimei/no-raw-http-response-in-handlers": "error",
    "taimei/no-port-import-in-spa-handlers": "error",
    "taimei/no-effect-in-db": "error",
    "taimei/repository-import-only-in-wiring": "error",
    "taimei/no-promise-all": "error",
    "taimei/run-background-only-in-background": "error",
    "taimei/sentry-capture-only-in-sentry-facade": "error",
    "taimei/audit-append-only-in-append": "error",
    "taimei/no-effect-ignore": "error",
    "taimei/log-error-only-in-email-client": "error",
    "taimei/capture-cause-only-in-listed-files": "error",
    "taimei/increment-rate-window-only-in-attempt-budget": "error",
    "taimei/membership-write-only-in-apply-change": "error",
    "taimei/last-used-company-write-only-in-current-company": "error",
    "taimei/settle-cause-only-in-adapters": "error",
    "taimei/auth-api-layer-only-in-run-route": "error",
    "taimei/auth-module-import-only-in-entry-files": "error",
    "taimei/auth-instance-import-only-in-app-and-auth-wiring": "error",
    "taimei/init-runtime-only-in-boot": "error",
    "taimei/issue-session-only-in-second-factor": "error",
    "taimei/get-session-only-in-session-check": "error",
    "taimei/api-error-shape-only-in-auth-wiring": "error",
    "taimei/db-import-in-src-tests-only-in-test-db": "error",
    "taimei/db-import-in-e2e-fixtures-only-db-testing": "error",
    "taimei/no-failing-layer-constructor-in-src": "error",
    "taimei/no-code-comment": "error",
    "taimei/no-design-number-in-test-name": "error",
    "taimei/proxy-hops-env-only-in-request-context": "error",
    "taimei/app-fetch-only-in-entry-files": "error",
    "taimei/service-key-env-only-in-service-key": "error",
    "taimei/service-key-compare-only-in-timing-safe-equal": "error",
    "taimei/service-key-header-only-in-app": "error",
    "taimei/no-hand-written-error-body": "error",
    "taimei/sentry-sdk-import-only-in-init-files": "error",
    "taimei/listed-mfa-import-only-in-auth-plugins": "error",
    "taimei/mfa-kill-switch-env-only-in-primary-auth": "error",
    "taimei/no-hand-written-cookie-attribute": "error",
    "taimei/mfa-totp-repo-only-in-listed-files": "error",
    "taimei/login-cookie-name-only-in-login-challenge": "error",
    "taimei/find-mfa-totp-only-in-listed-files": "error",
    "taimei/verified-at-only-in-mfa-policy": "error",
    "taimei/listed-import-only-in-management": "error",
    "taimei/no-src-import-in-db": "error",
    "taimei/no-import-in-mfa-policy": "error",
    "taimei/no-hono-in-guard": "error",
    "taimei/verified-only-in-guard": "error",
    "taimei/account-deletion-only-in-delete-account": "error",
    "taimei/delete-account-only-in-delete-account-and-orphan": "error",
    "taimei/no-unordered-owner-lock": "error",
    "taimei/no-better-auth-delete-user": "error",
    "taimei/delete-user-sessions-only-in-delete-sessions": "error",
    "taimei/route-literals-only-in-primary-auth-routes": "error",
    "taimei/display-text-cast-only-in-sanitize": "error",
    "taimei/health-ping-only-in-probe": "error",
    "taimei/no-catch-in-health-drivers": "error",
    "taimei/health-route-only-in-health-handler": "error",
    "taimei/no-direct-runtime-in-health-handler": "error",
    "taimei/local-hostname-check-only-in-local-database": "error",
    "taimei/create-user-only-in-test-user-use-case": "error",
    "taimei/app-env-only-in-outside-production-check": "error",
    "taimei/no-io-resource-import-in-runtime": "error",
    "taimei/current-company-write-only-in-testing-use-cases": "error"
  },
  "overrides": [
    {
      "files": ["src/**", "db/**", "management/**", "testing/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": [
                  "class-variance-authority",
                  "clsx",
                  "@effect/platform-browser",
                  "@foldkit/ui",
                  "foldkit",
                  "lucide",
                  "qrcode",
                  "tailwind-merge"
                ],
                "message": "web 専用 devDependency のため server runtime に存在しない。server で必要になったら dependencies へ戻す (docs/adr/0014-docker-runner-dev-stage-separation.md)"
              },
              {
                "group": ["@connectrpc/connect-node"],
                "message": "削除済み依存。再導入しない (ADR-0011 / ADR-0014)"
              },
              {
                "group": ["effect/*", "effect/**"],
                "message": "effect は root から import する。effect/http や effect/sql などの area module は @stability unstable で、minor で breaking し得る (docs/adr/0017-effect-v4-full-adoption.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**", "testing/**"],
      "excludeFiles": ["src/**/__tests__/**", "src/auth.ts", "testing/__tests__/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm",
                "message": "src/* からは drizzle を直叩きせず db/repositories/* を経由すること (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)。better-auth schema 利用の例外は src/auth.ts のみ (db/CLAUDE.md「例外 path (正本)」)"
              },
              {
                "name": "@/db/schema",
                "message": "src/* からは drizzle schema を直接 import せず db/repositories/* を経由すること (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)。better-auth schema 利用の例外は src/auth.ts のみ"
              },
              {
                "name": "@/db/client",
                "message": "src/* からは @/db/client を直接 import せず db/repositories/* を経由すること (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)。better-auth schema 利用の例外は src/auth.ts のみ。Workers entry (src/worker.ts) の runtime bootstrap は oxlint-disable-next-line で個別に許可"
              },
              {
                "name": "better-auth/cookies",
                "importNames": ["getSessionCookie"],
                "message": "session cookie は src/session-cookie.ts の sessionCookieOf で読む (cookie の名前は SDK の 1 か所が持つ)"
              }
            ],
            "patterns": [
              {
                "group": [
                  "class-variance-authority",
                  "clsx",
                  "@effect/platform-browser",
                  "@foldkit/ui",
                  "foldkit",
                  "lucide",
                  "qrcode",
                  "tailwind-merge"
                ],
                "message": "web 専用 devDependency のため server runtime に存在しない。server で必要になったら dependencies へ戻す (docs/adr/0014-docker-runner-dev-stage-separation.md)"
              },
              {
                "group": ["@connectrpc/connect-node"],
                "message": "削除済み依存。再導入しない (ADR-0011 / ADR-0014)"
              },
              {
                "group": ["effect/*", "effect/**"],
                "message": "effect は root から import する。effect/http や effect/sql などの area module は @stability unstable で、minor で breaking し得る (docs/adr/0017-effect-v4-full-adoption.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/**/*-contract.ts", "src/spa-contract-table.ts"],
      "excludeFiles": ["src/**/__tests__/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm",
                "message": "src/* からは drizzle を直叩きせず db/repositories/* を経由すること (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)。better-auth schema 利用の例外は src/auth.ts のみ (db/CLAUDE.md「例外 path (正本)」)"
              },
              {
                "name": "@/db/schema",
                "message": "src/* からは drizzle schema を直接 import せず db/repositories/* を経由すること (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)。better-auth schema 利用の例外は src/auth.ts のみ"
              },
              {
                "name": "@/db/client",
                "message": "src/* からは @/db/client を直接 import せず db/repositories/* を経由すること (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)。better-auth schema 利用の例外は src/auth.ts のみ。Workers entry (src/worker.ts) の runtime bootstrap は oxlint-disable-next-line で個別に許可"
              },
