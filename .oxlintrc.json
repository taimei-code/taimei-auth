                "importNames": ["getSessionCookie"],
                "message": "session cookie は src/session-cookie.ts の sessionCookieOf で読む (cookie の名前は SDK の 1 か所が持つ)"
              },
              {
                "name": "effect/http-api",
                "importNames": ["HttpApiBuilder", "HttpApiTest"],
                "message": "契約の module は web と共有するため、server の実装 (HttpApiBuilder) を import しない。実装は src/handlers/*-http-api.ts に置く"
              }
            ],
            "patterns": [
              {
                "group": [
                  "class-variance-authority",
                  "clsx",
                  "@effect/platform-browser",
                  "@foldkit/ui",
                  "foldkit",
                  "lucide",
                  "qrcode",
                  "tailwind-merge"
                ],
                "message": "web 専用 devDependency のため server runtime に存在しない。server で必要になったら dependencies へ戻す (docs/adr/0014-docker-runner-dev-stage-separation.md)"
              },
              {
                "group": ["@connectrpc/connect-node"],
                "message": "削除済み依存。再導入しない (ADR-0011 / ADR-0014)"
              },
              {
                "group": ["effect/*", "effect/**", "!effect/http-api"],
                "message": "effect の subpath は使い道を決めたものだけ許す。契約 (*-contract.ts) は effect/http-api、Hono に載せる実装 (handlers/*-http-api.ts) は加えて effect/http (docs/adr/0017-effect-v4-full-adoption.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["src/handlers/*-http-api.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "drizzle-orm",
                "message": "src/* からは drizzle を直叩きせず db/repositories/* を経由すること (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)。better-auth schema 利用の例外は src/auth.ts のみ (db/CLAUDE.md「例外 path (正本)」)"
