    {
      "files": ["e2e/**"],
      "excludeFiles": ["e2e/fixtures.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["@/db/**", "**/db/**", "drizzle-orm", "drizzle-orm/**", "pg"],
                "message": "e2e の DB 接触は fixture 再生成に限り e2e/fixtures.ts に閉じる (db/CLAUDE.md「例外 path (正本)」)。spec からは helpers.ts の reseedFixture (子プロセス) を使うこと — spec プロセスに pg Pool を開くと閉じる手段が無く runner が hang する"
              },
              {
                "group": ["effect", "effect/*", "effect/**"],
                "message": "e2e は effect を直接 import しない。モックの path と失敗の応答は e2e/contract-mock.ts で契約から作る (docs/adr/0017-effect-v4-full-adoption.md)"
              }
            ]
          }
        ]
      }
    },
    {
      "files": ["web/**"],
      "excludeFiles": ["web/src/shared/ui/dialog-view.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "paths": [
              {
                "name": "sonner",
                "message": "通知は web/src/shared/ui/toast-view.ts の Toast で出す。sonner は React の部品なので web では使わない (docs/adr/0023-web-foldkit.md)"
              },
              {
                "name": "drizzle-orm",
                "message": "DB への接触は db/ に閉じる (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)"
              },
              {
                "name": "pg",
                "message": "DB への接触は db/ に閉じる (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)"
              },
              {
                "name": "foldkit/route",
                "message": "route は app/*/route.ts だけが定義する (docs/adr/0023-web-foldkit.md)"
              },
              {
                "name": "foldkit",
                "importNames": ["Route"],
                "message": "route は app/*/route.ts だけが定義する (docs/adr/0023-web-foldkit.md)"
              },
              {
                "name": "@foldkit/ui",
                "importNames": ["Dialog"],
                "message": "dialog は web/src/shared/ui/dialog-view.ts の dialogView と Dialog で書く (class を受け取らない house の dialog。docs/adr/0023-web-foldkit.md)"
              }
            ],
            "patterns": [
              {
                "group": [
                  "effect/*",
                  "effect/**",
                  "!effect/http",
                  "!effect/crypto",
                  "!effect/persistence"
                ],
                "message": "web で使える effect の subpath は effect/http・effect/crypto・effect/persistence だけ (docs/adr/0017-effect-v4-full-adoption.md、docs/adr/0023-web-foldkit.md)"
              },
              {
                "group": ["drizzle-orm/**"],
                "message": "DB への接触は db/ に閉じる (db/CLAUDE.md「DB アクセスは `db/` に閉じる」)"
              },
              {
                "group": ["@/*", "@/**"],
                "message": "web の domain の内部は相対 import で書く (web/src/CLAUDE.md、docs/adr/0023-web-foldkit.md)"
              },
              {
                "group": ["react", "react/*", "react-dom", "react-dom/*"],
                "message": "web は React を使わない。画面は Foldkit で書く (docs/adr/0023-web-foldkit.md)"
              }
            ]
          }
        ]
      }
    },
