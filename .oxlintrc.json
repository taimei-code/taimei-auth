    "taimei/mfa-totp-repo-only-in-listed-files": "error",
    "taimei/login-cookie-name-only-in-login-challenge": "error",
    "taimei/passkey-challenge-keys-only-in-webauthn": "error",
    "taimei/find-mfa-totp-only-in-listed-files": "error",
    "taimei/verified-at-only-in-mfa-policy": "error",
    "taimei/passkey-transports-only-in-passkey-entry": "error",
    "taimei/passkey-limit-only-in-passkey-policy": "error",
    "taimei/flagship-binding-only-in-feature-flags": "error",
    "taimei/feature-flags-port-only-in-flag-decisions": "error",
    "taimei/no-flag-decision-in-handlers-rpc-web": "error",
    "taimei/listed-import-only-in-management": "error",
    "taimei/no-src-import-in-db": "error",
    "taimei/no-import-in-mfa-policy": "error",
    "taimei/no-hono-in-guard": "error",
    "taimei/verified-only-in-guard": "error",
    "taimei/account-deletion-only-in-delete-account": "error",
    "taimei/delete-account-only-in-delete-account-and-orphan": "error",
    "taimei/no-unordered-owner-lock": "error",
    "taimei/no-better-auth-delete-user": "error",
    "taimei/delete-user-sessions-only-in-delete-sessions": "error",
    "taimei/route-literals-only-in-primary-auth-routes": "error",
    "taimei/display-text-cast-only-in-sanitize": "error",
    "taimei/health-ping-only-in-probe": "error",
    "taimei/no-catch-in-health-drivers": "error",
    "taimei/health-route-only-in-health-handler": "error",
    "taimei/no-direct-runtime-in-health-handler": "error",
    "taimei/local-hostname-check-only-in-local-database": "error",
    "taimei/create-user-only-in-test-user-use-case": "error",
    "taimei/app-env-only-in-outside-production-check": "error",
    "taimei/no-io-resource-import-in-runtime": "error",
    "taimei/current-company-write-only-in-testing-use-cases": "error",
    "taimei/no-policy-or-transaction-in-transport": "error",
    "taimei/no-audit-in-transport": "error",
    "taimei/db-import-only-in-db": "error",
    "taimei/db-value-import-only-in-db-in-tests": "error",
    "taimei/db-testing-import-only-in-listed-files": "error",
    "taimei/persisted-feature-flags-only-in-dev-worker": "error",
    "taimei/pg-import-only-in-db-client": "error",
    "taimei/tagged-error-only-in-failure": "error",
    "taimei/failure-only-in-failures-and-domain-errors": "error",
    "taimei/boundary-error-construction-only-in-errors": "error",
    "taimei/effect-run-only-in-listed-files": "error",
    "taimei/clock-and-id-only-in-services": "error",
    "taimei/ttl-store-driver-import-only-in-entry-files": "error",
    "taimei/email-send-only-in-email-wiring": "error",
    "taimei/connect-error-only-in-run-rpc": "error",
    "taimei/no-with-headers-in-http-api": "error",
    "taimei/no-services-or-utils-dir": "error",
    "taimei/fixtures-import-only-in-seed": "error",
    "taimei/page-route-only-in-contract-mock": "error",
    "taimei/server-log-only-in-helpers": "error",
    "taimei/feature-flag-switch-only-in-helpers": "error",
    "taimei/login-links-only-in-helpers": "error",
    "taimei/declared-failure-only-in-contract-mock": "error",
    "taimei/leave-spa-import-only-in-app": "error",
    "taimei/account-deleted-message-only-in-owning-page": "error",
    "taimei/company-change-message-only-in-owning-module": "error",
    "taimei/failure-messages-not-exported": "error",
    "taimei/dialog-held-report-only-in-dialog-view": "error",
    "taimei/dialog-transition-state-only-in-dialog-view": "error",
    "taimei/dialog-visible-only-by-is-dialog-visible": "error",
    "taimei/mfa-failure-messages-import-only-in-mfa": "error",
    "taimei/page-request-only-in-page-request": "error",
    "taimei/form-only-in-form-view": "error",
    "taimei/no-external-font-host": "error",
    "taimei/no-effect-die-in-web": "error",
    "taimei/no-hand-rolled-page-builders": "error",
    "taimei/no-hand-written-current-marker": "error",
    "taimei/mfa-failure-text-only-in-mfa-failure-messages": "error",
    "taimei/redirect-allowlist-not-in-web": "error",
    "taimei/no-fixme-in-e2e": "error",
    "taimei/no-build-env-in-runtime-selection": "error",
    "taimei/sdk-import-only-peer-dependencies": "error",
    "taimei/no-react-outside-web": "error",
    "taimei/no-process-cwd-in-e2e": "error",
    "taimei/spa-transport-failure-only-in-contract-failure": "error",
    "taimei/no-web-only-dependency-in-server": "error",
    "taimei/no-connect-node": "error",
    "taimei/no-effect-subpath-in-server": "error",
    "taimei/no-effect-subpath-in-server-tests": "error",
    "taimei/effect-subpath-in-contract-only-http-api": "error",
    "taimei/effect-subpath-in-http-api-handlers-only-http": "error",
    "taimei/raw-session-cookie-only-in-entry-redirects": "error",
    "taimei/get-session-cookie-only-in-auth": "error",
    "taimei/no-server-implementation-in-contract": "error",
    "taimei/no-effect-in-e2e": "error",
    "taimei/no-sonner-in-web": "error",
    "taimei/no-react-in-web": "error",
    "taimei/no-root-alias-in-web": "error",
    "taimei/effect-subpath-in-web-only-listed": "error",
    "taimei/route-only-in-route-files": "error",
    "taimei/foldkit-dialog-only-in-dialog-view": "error"
  },
  "overrides": [
    {
      "files": ["web/src/**"],
      "excludeFiles": ["web/src/**/__tests__/**"],
      "rules": {
        "no-restricted-globals": [
          "error",
          {
            "name": "URLSearchParams",
            "message": "search は app/*/route.ts の route の parser で読む (docs/adr/0023-web-foldkit.md)"
          }
        ]
      }
    },
    {
      "files": ["web/src/**", "web/non-production/**"],
      "excludeFiles": ["web/src/**/__tests__/**", "web/non-production/**/__tests__/**"],
      "rules": {
        "taimei/no-effect-run-in-web": "error",
        "taimei/no-browser-global-outside-command": "error",
        "taimei/no-timer-clock-random-in-foldkit": "error",
        "taimei/no-atom-import-in-foldkit": "error",
        "taimei/no-raw-form-element": "error",
        "taimei/no-direct-application-start": "error",
        "typescript/consistent-type-assertions": [
          "error",
          {
            "assertionStyle": "never"
          }
        ]
      }
    },
    {
      "files": ["web/src/**", "web/non-production/**"],
      "rules": {
        "foldkit/acquire-release-constructs-in-acquire-body": "error",
        "foldkit/command-binding-matches-name": "error",
        "foldkit/command-define-pascal-const": "error",
        "foldkit/got-prefix-requires-submodel-payload": "error",
        "foldkit/got-submodel-message-name": "error",
        "foldkit/got-wrapper-carries-only-routing": "error",
        "foldkit/keyed-required-for-mapped-rows": "error",
        "foldkit/lazy-view-stable-references": "error",
        "foldkit/mount-factory-must-use-element": "error",
        "foldkit/no-array-index-view-keys": "error",
        "foldkit/no-child-message-construction-in-root": "error",
        "foldkit/no-direct-submodel-state-update": "error",
        "foldkit/no-disabling-dev-guardrails": "error",
        "foldkit/no-duplicate-onmount-per-element": "error",
        "foldkit/no-empty-children-array": "error",
        "foldkit/no-empty-commands-array": "error",
        "foldkit/no-empty-to-parent-out-message": "error",
        "foldkit/no-empty-object-tagged-call": "error",
        "foldkit/no-hand-rolled-command-struct": "error",
        "foldkit/no-hardcoded-route-strings": "error",
        "foldkit/no-impure-call-at-decision-time": "error",
        "foldkit/no-module-level-mutable-state": "error",
        "foldkit/no-nonportable-server-globals": "off",
        "foldkit/no-noop-message": "error",
        "foldkit/no-prevent-default-in-stream-operator": "error",
        "foldkit/no-raw-dom-event-attributes": "error",
        "foldkit/no-route-query-constructor-default": "error",
        "foldkit/no-spread-in-modify-fields": "error",
        "foldkit/no-switch-on-message-tag": "error",
        "foldkit/prefer-callable-message-constructor": "error",
        "foldkit/prefer-command-mapmessage": "error",
        "foldkit/prefer-effect-module-names": "error",
        "foldkit/prefer-option-over-nullable-in-model": "error",
        "foldkit/require-fold-for-child-update-result": "error",
        "foldkit/require-rel-for-external-link": "error",
        "foldkit/selection-submodel-factory-at-module-scope": "error",
        "foldkit/wrap-child-output-in-got-message": "error"
      }
    },
    {
      "files": ["**/*.test.ts", "**/*.test.tsx", "**/*.spec.ts", "**/*.spec.tsx"],
      "rules": {
        "foldkit/command-binding-matches-name": "off",
        "foldkit/command-define-pascal-const": "off",
        "foldkit/got-prefix-requires-submodel-payload": "off",
        "foldkit/got-submodel-message-name": "off",
        "foldkit/got-wrapper-carries-only-routing": "off",
        "foldkit/keyed-required-for-mapped-rows": "off",
        "foldkit/lazy-view-stable-references": "off",
        "foldkit/mount-factory-must-use-element": "off",
        "foldkit/no-array-index-view-keys": "off",
        "foldkit/no-child-message-construction-in-root": "off",
        "foldkit/no-direct-submodel-state-update": "off",
        "foldkit/no-disabling-dev-guardrails": "off",
        "foldkit/no-duplicate-onmount-per-element": "off",
        "foldkit/no-empty-children-array": "off",
        "foldkit/no-empty-commands-array": "off",
        "foldkit/no-empty-to-parent-out-message": "off",
        "foldkit/no-empty-object-tagged-call": "off",
        "foldkit/no-hand-rolled-command-struct": "off",
        "foldkit/no-hardcoded-route-strings": "off",
        "foldkit/no-impure-call-at-decision-time": "off",
        "foldkit/no-module-level-mutable-state": "off",
        "foldkit/no-nonportable-server-globals": "off",
        "foldkit/no-noop-message": "off",
        "foldkit/no-prevent-default-in-stream-operator": "off",
        "foldkit/no-raw-dom-event-attributes": "off",
        "foldkit/no-route-query-constructor-default": "off",
        "foldkit/no-spread-in-modify-fields": "off",
        "foldkit/prefer-callable-message-constructor": "off",
        "foldkit/prefer-command-mapmessage": "off",
        "foldkit/prefer-option-over-nullable-in-model": "off",
        "foldkit/require-fold-for-child-update-result": "off",
        "foldkit/require-rel-for-external-link": "off",
        "foldkit/selection-submodel-factory-at-module-scope": "off",
        "foldkit/wrap-child-output-in-got-message": "off"
      }
    },
    {
      "files": ["web/src/**", "web/non-production/**"],
      "rules": {
        "curly": ["error", "all"]
      }
    },
    {
      "files": ["web/src/shared/ui/**"],
      "rules": {
        "taimei/no-raw-form-element": "off"
      }
    },
    {
      "files": ["web/src/app/start-application.ts"],
      "rules": {
        "taimei/no-direct-application-start": "off"
      }
    },
    {
      "files": ["web/src/app/*/entry.ts", "web/non-production/main.ts"],
      "rules": {
        "taimei/no-browser-global-outside-command": "off",
        "foldkit/no-impure-call-at-decision-time": "off"
      }
    },
    {
      "files": ["packages/auth-client/src/testing.ts"],
      "rules": {
        "import/extensions": [
          "error",
          "always",
          {
            "ignorePackages": true,
            "checkTypeImports": true
          }
        ]
      }
    },
    {
      "files": ["web/src/shared/__tests__/dialog-resolvers.ts"],
      "rules": {
        "foldkit/no-child-message-construction-in-root": "off"
      }
    },
    {
      "files": ["**/__tests__/**"],
      "rules": {
        "typescript/await-thenable": "off"
      }
    }
  ]
}
