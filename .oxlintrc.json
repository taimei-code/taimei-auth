                  "clsx",
                  "@effect/platform-browser",
                  "@foldkit/ui",
                  "foldkit",
                  "lucide",
                  "qrcode",
                  "tailwind-merge"
                ],
                "message": "web 専用 devDependency のため server runtime に存在しない。server で必要になったら dependencies へ戻す (docs/adr/0014-docker-runner-dev-stage-separation.md)"
              },
              {
                "group": ["@connectrpc/connect-node"],
                "message": "削除済み依存。再導入しない (ADR-0011 / ADR-0014)"
              },
              {
                "group": ["effect/*", "effect/**", "!effect/http-api", "!effect/http"],
                "message": "effect の subpath は使い道を決めたものだけ許す。契約 (*-contract.ts) は effect/http-api、Hono に載せる実装 (handlers/*-http-api.ts) は加えて effect/http (docs/adr/0017-effect-v4-full-adoption.md)"
              }
