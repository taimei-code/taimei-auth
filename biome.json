{
  "$schema": "https://biomejs.dev/schemas/2.4.14/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "includes": [
      "**",
      "!**/node_modules",
      "!**/dist",
      "!web/dist",
      "!drizzle",
      "!src/gen",
      "!packages/auth-client/dist",
      "!packages/auth-client/src/gen",
      "!bun.lock",
      "!web/src/index.css"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "assist": {
    "enabled": true,
    "actions": {
      "source": {
        "organizeImports": "off"
      }
    }
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "style": {
        "noNonNullAssertion": "off",
        "useImportType": "off"
      },
      "suspicious": {
        "noExplicitAny": "off",
        "noImplicitAnyLet": "warn",
        "noUnknownAtRules": "off"
      },
      "correctness": {
        "noUnusedImports": "warn",
        "noPrivateImports": "off"
      },
      "complexity": {
        "useOptionalChain": "warn"
      },
      "a11y": {
        "useAnchorContent": "warn"
      },
      "performance": {
        "noBarrelFile": "off"
      }
    }
  },
  "overrides": [
    {
      "includes": ["src/rpc/**", "!src/rpc/__tests__/**"],
      "linter": {
        "rules": {
          "style": {
            "noRestrictedImports": {
              "level": "error",
              "options": {
                "paths": {
                  "drizzle-orm": "src/rpc/* からは drizzle を直叩きせず db/repositories/* を経由すること (CLAUDE.md ルール 2 / ADR-006 D2)",
                  "@/db/schema": "src/rpc/* からは drizzle を直叩きせず db/repositories/* を経由すること (CLAUDE.md ルール 2 / ADR-006 D2)",
                  "@/db/client": "src/rpc/* からは drizzle を直叩きせず db/repositories/* を経由すること (CLAUDE.md ルール 2 / ADR-006 D2)"
                }
              }
            }
          }
        }
      }
    }
  ],
  "javascript": {
    "formatter": {
      "quoteStyle": "double",
      "semicolons": "always",
      "trailingCommas": "all"
    }
  },
  "css": {
    "formatter": {
      "enabled": true
    }
  }
}
