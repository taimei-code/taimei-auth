{
  "name": "@taimei-code/auth-client",
  "version": "3.0.0",
  "description": "taimei-auth 認証サービスのクライアント SDK",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./server": {
      "types": "./dist/server.d.ts",
      "default": "./dist/server.js"
    },
    "./guard": {
      "types": "./dist/guard.d.ts",
      "default": "./dist/guard.js"
    },
    "./cookie": {
      "types": "./dist/cookie.d.ts",
      "default": "./dist/cookie.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "rm -rf dist && tsc -p tsconfig.build.json --outDir dist --declaration --declarationMap",
    "prepublishOnly": "bun run build"
  },
  "peerDependencies": {
    "@bufbuild/protobuf": "^2.0.0",
    "@connectrpc/connect": "^2.0.0"
  },
  "devDependencies": {
    "typescript": "7.0.2"
  }
}
