{
  // Cloudflare Workers の設定。設計の詳細は docs/adr/0011-cloudflare-workers-migration.md を参照。
  // 本番では hyperdrive.id を実際の Hyperdrive config の id に、vars を本番の値にし、
  // secret (AUTH_SECRET、AUTH_SERVICE_KEY、SENTRY_DSN、MFA_TOTP_ENCRYPTION_KEYS) は `wrangler secret put` で注入する。
  // ローカルでは localConnectionString と、scripts/wrangler-dev.sh が渡す --env-file を使う
  // (--env-file を指定した時は wrangler が .dev.vars と .env を読まない)。
  "name": "taimei-auth",
  "main": "src/worker.ts",
  "compatibility_date": "2025-04-01",
  "compatibility_flags": ["nodejs_compat", "delete_all_deletes_alarm"],
  "assets": {
    "directory": "./web/dist",
    "binding": "ASSETS",
    // worker を常に先に走らせ (/ の loginShortcut などが静的な index.html に取られないように)、
    // worker が扱わないパスを env.ASSETS.fetch へ委譲する。deep link は SPA の fallback で処理する。
    "run_worker_first": true,
    "not_found_handling": "single-page-application"
  },
  // session、verification、試行枠、MFA チャレンジの TTL store。1 つの key が 1 つの object に対応する (src/kv-store.do.ts、ADR-0019)。
  "durable_objects": { "bindings": [{ "name": "KV_STORE", "class_name": "KvStore" }] },
  "migrations": [{ "tag": "v1", "new_sqlite_classes": ["KvStore"] }],
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      "id": "1c0d32b60a144a3cabc729bd83484276",
      "localConnectionString": "postgres://postgres:password@127.0.0.1:5435/auth"
    }
  ],
  "vars": {
    "APP_ENV": "production",
    "APP_NAME": "taimei",
    "AUTH_SERVICE_URL": "https://auth.taimei-code.com",
    "AUTH_COOKIE_DOMAIN": "taimei-code.com",
    "AUTH_TRUSTED_ORIGINS": "https://app.taimei-code.com,https://auth.taimei-code.com",
    // from は Resend で検証済みのドメイン (transactional.taimei-code.com) のアドレスにする。
    // 未設定だと client.ts の既定値 onboarding@resend.dev になり、Resend のテストモードでは
    // アカウント所有者宛にしか送れないため、任意のユーザーへの magic-link が 403 になる。
    "AUTH_FROM_EMAIL_MAGIC_LINK": "noreply@transactional.taimei-code.com",
    "AUTH_FROM_EMAIL_WELCOME": "noreply@transactional.taimei-code.com",
    "AUTH_FROM_EMAIL_INVITATION": "noreply@transactional.taimei-code.com",
    "AUTH_FROM_EMAIL_SECURITY": "noreply@transactional.taimei-code.com"
  },
  // 本番ドメイン。custom_domain:true にすると Cloudflare が auth.taimei-code.com の DNS レコードと
  // TLS 証明書を管理し、Worker に紐付ける。サブドメインをまたぐ cookie (.taimei-code.com) のため、
  // workers.dev ではなくこのホストで配信する必要がある (ADR-0004 と ADR-0011)。
  // deploy.yml の smoke が version override header で呼んだ応答の version を /health で照合する。
  "version_metadata": { "binding": "CF_VERSION_METADATA" },
  "routes": [{ "pattern": "auth.taimei-code.com", "custom_domain": true }]
}
