{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "typeRoots": ["../../node_modules/@types"],
    "paths": { "@core/*": ["../../src/*"] }
  },
  "include": ["shared", "apps/tsr-atom", "probes/tsr-*.tsx"]
}
