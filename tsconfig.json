{
  "compilerOptions": {
    "target": "ES2023",
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "composite": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "types": ["bun"],
    "jsx": "react-jsx",
    "paths": {
      "@/*": ["./*"],
      "@core/*": ["./src/*"]
    },
    "plugins": [
      {
        "name": "@effect/language-service",
        // unstable と承知で採用した module (docs/adr/0017-effect-v4-full-adoption.md)
        "allowedUnstableApis": [
          "effect/http-api",
          "effect/http",
          "effect/reactivity",
          "@effect/atom-react"
        ],
        "diagnosticSeverity": {
          // runtime や配列を呼んだ時点で読むため、Layer・Effect を関数で返す
          "lazyEffect": "off"
        },
        "overrides": [
          {
            // @ts-expect-error で型エラーを確かめる行に、tsc の型エラーと重ねて出る
            "include": ["**/*.test.ts"],
            "options": {
              "diagnosticSeverity": {
                "missingEffectContext": "off",
                "missingEffectError": "off"
              }
            }
          }
        ]
      }
    ]
  },
  "include": [
    "worker-configuration.d.ts",
    "src/**/*.ts",
    "src/**/*.tsx",
    "db/**/*.ts",
    "management/**/*.ts",
    "e2e/**/*.ts",
    "web/src/shared/leave-spa.ts",
    "playwright.config.ts"
  ],
  "exclude": ["node_modules", "dist", "packages"]
}
