{
  "name": "taimei-auth",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [],
  "scripts": {
    "dev:web": "vite --configLoader runner --config web/non-production/vite.config.ts",
    "build:web": "vite build --configLoader runner --config web/vite.config.ts",
    "build:web:non-production": "vite build --configLoader runner --config web/non-production/vite.config.ts",
    "generate": "buf generate",
    "generate:check": "diff -r src/gen packages/auth-client/src/gen",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "bun run db/migrate.ts",
    "db:migrate-manual": "bun run db/migrate-manual.ts",
    "sweep:abandoned-signups": "bun run management/sweep-abandoned-signups.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "check": "bun run typecheck && bun run lint && bun run generate:check && bun run types:check && bun test",
    "lint": "oxlint --type-aware --disable-nested-config --deny-warnings --report-unused-disable-directives && biome format && fallow audit",
    "lint:fix": "oxlint --type-aware --disable-nested-config --fix && bun run format",
    "format": "biome format --write",
    "typecheck": "bash scripts/typecheck.sh",
    "types": "wrangler types --include-env=false",
    "types:check": "bun run types --check"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@sentry/bun": "^10.51.0",
    "@sentry/cloudflare": "^10.57.0",
    "@taimei-code/auth-client": "workspace:*",
    "@vercel/blob": "^2.3.3",
    "better-auth": "^1.7.12",
    "drizzle-orm": "^0.45.2",
    "effect": "4.1.2",
    "hono": "^4.12.25",
    "nanoid": "^5.1.11",
    "otpauth": "9.5.1",
    "pg": "^8.16.3",
    "resend": "^6.6.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@alchemy.run/cloudflare": "2.0.0-beta.85",
    "@better-auth/utils": "0.5.1",
    "@biomejs/biome": "^2.6.6",
    "@bufbuild/buf": "^1.75.0",
    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@effect/platform-browser": "4.1.2",
    "@effect/platform-bun": "4.1.2",
    "@effect/platform-node": "4.1.2",
    "@effect/tsgo": "0.56.0",
    "@foldkit/oxlint-plugin": "0.15.4",
    "@foldkit/ui": "0.170.0",
    "@foldkit/vite-plugin": "0.29.0",
    "@playwright/test": "^1.65.0",
    "@tailwindcss/forms": "^0.5.11",
    "@types/bun": "^1.4.4",
    "@types/node": "26.6.6",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "alchemy": "2.0.0-beta.85",
    "autoprefixer": "^10.6.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.11",
    "fallow": "^3.40.0",
    "foldkit": "0.170.0",
    "lucide": "1.70.0",
    "oxlint": "^1.92.0",
    "oxlint-tsgolint": "7.0.2006",
    "postcss": "^8.5.32",
    "qrcode": "^1.5.4",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "4.3.5",
    "typescript": "7.0.2",
    "vite": "^8.3.6",
    "wrangler": "^4.158.0"
  },
  "overrides": {
    "source-map-js": "^1.2.2",
    "defu": "^6.1.7",
    "kysely": "^0.28.17",
    "esbuild": "0.28.1",
    "undici": "6.29.1",
    "ws": "8.21.0",
    "sharp": "0.35.5"
  }
}
