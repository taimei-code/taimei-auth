{
  "name": "taimei-auth",
  "version": "0.0.1",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "trustedDependencies": [],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev:web": "vite --config web/vite.config.ts",
    "build:web": "vite build --config web/vite.config.ts",
    "generate": "buf generate && cp -r src/gen/. packages/auth-client/src/gen/",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:migrate-manual": "bun run db/migrate-manual.ts",
    "sweep:abandoned-signups": "bun run management/sweep-abandoned-signups.ts",
    "test": "bun test",
    "test:e2e": "playwright test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "typecheck": "tsc --noEmit && tsc --noEmit -p web/tsconfig.json"
  },
  "dependencies": {
    "@bufbuild/protobuf": "^2.11.0",
    "@connectrpc/connect": "^2.1.1",
    "@react-email/components": "^1.0.2",
    "@sentry/bun": "^10.51.0",
    "@sentry/cloudflare": "^10.57.0",
    "@taimei-code/auth-client": "workspace:*",
    "@upstash/redis": "^1.38.0",
    "@vercel/blob": "^2.3.3",
    "better-auth": "^1.6.23",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.12.25",
    "nanoid": "^5.1.11",
    "pg": "^8.16.3",
    "react": "^19.2.5",
    "react-dom": "^19.2.5",
    "redis": "^6.2.0",
    "resend": "^6.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@better-auth/utils": "0.4.2",
    "@biomejs/biome": "^2.4.14",
    "@bufbuild/buf": "^1.66.1",
    "@bufbuild/protoc-gen-es": "^2.11.0",
    "@playwright/test": "^1.62.0",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.2.4",
    "@tailwindcss/forms": "^0.5.11",
    "@types/bun": "^1.3.13",
    "@types/node": "20.14.8",
    "@types/pg": "^8.20.0",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "autoprefixer": "^10.5.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-kit": "^0.31.4",
    "lucide-react": "^0.482.0",
    "postcss": "^8.5.23",
    "qrcode": "^1.5.4",
    "react-router-dom": "^7.18.1",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.5.0",
    "tailwindcss": "3.4.4",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "7.0.2",
    "vite": "^8.0.16",
    "wrangler": "^4.100.0"
  },
  "overrides": {
    "defu": "^6.1.7",
    "kysely": "^0.28.17",
    "esbuild": "0.28.1",
    "undici": "6.27.0",
    "ws": "8.21.0",
    "sharp": "0.35.3"
  }
}
